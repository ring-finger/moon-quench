---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';

interface Props {
  title: string;
  description?: string;
  active?: string;
  /** 布局模式：home 首页（无导航栏） | page 功能页（有导航但无返回首页入口） */
  mode?: 'home' | 'page';
}
const {
  title,
  description = '饮月听风 · 个人作品集',
  active = '',
  mode = 'page',
} = Astro.props;

const base = import.meta.env.BASE_URL;
// 功能页导航：不含「首页」，也不提供返回首页的入口
const navItems = [
  { href: `${base}blog`, label: '灵犀小筑', key: 'blog' },
  { href: `${base}travel`, label: '旅游小记', key: 'travel' },
  { href: `${base}radio`, label: '无线电波', key: 'radio' },
];
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    {
      mode === 'page' && (
        <nav class="site-nav">
          <div class="nav-inner">
            <!-- 品牌标识不链接，不提供返回首页入口 -->
            <span class="brand brand-static">
              <span class="logo logo-svg">
                <BrandMark size={32} />
              </span>
              <span>饮月听风</span>
            </span>
            <div class="nav-links">
              {
                navItems.map((item) => (
                  <a href={item.href} class={active === item.key ? 'active' : ''}>
                    {item.label}
                  </a>
                ))
              }
            </div>
          </div>
        </nav>
      )
    }

    <slot />

    {
      mode === 'page' && (
        <footer class="site-footer">
          饮月听风 · 记录作品、旅途与电波
        </footer>
      )
    }
  </body>
</html>
