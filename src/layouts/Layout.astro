---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';

interface Props {
  title: string;
  description?: string;
  /** 布局模式：home 首页（无导航栏） | page 功能页（有导航但无返回首页入口） */
  mode?: 'home' | 'page';
}
const {
  title,
  description = '饮月听风 · 个人作品集',
  mode = 'page',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    {
      mode === 'page' && (
        <nav class="site-nav">
          <div class="nav-inner">
            <!-- 品牌标识不链接，不提供返回首页入口；子模块之间也不互相跳转 -->
            <span class="brand brand-static">
              <span class="logo logo-svg">
                <BrandMark size={32} />
              </span>
              <span>饮月听风</span>
            </span>
          </div>
        </nav>
      )
    }

    <slot />

    {
      mode === 'page' && (
        <footer class="site-footer">
          饮月听风 · 记录作品、旅途与电波
        </footer>
      )
    }

    <!-- 访问量统计（不蒜子 busuanzi.cc） -->
    <div class="busuanzi-bar">
      <span>今日访问 <span id="busuanzi_today_pv">-</span> 次</span>
      <span class="sep">·</span>
      <span>本站访问 <span id="busuanzi_site_pv">-</span> 次</span>
      <span class="sep">·</span>
      <span>今日访客 <span id="busuanzi_today_uv">-</span> 人</span>
      <span class="sep">·</span>
      <span>本站访客 <span id="busuanzi_site_uv">-</span> 人</span>
    </div>

    <script src="//cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js" defer></script>
  </body>
</html>
