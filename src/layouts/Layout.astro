---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';

interface Props {
  title: string;
  description?: string;
  /** 布局模式：home 首页（无导航栏） | page 功能页（有导航但无返回首页入口） */
  mode?: 'home' | 'page';
}
const {
  title,
  description = '饮月听风 · 个人作品集',
  mode = 'page',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    {
      mode === 'page' && (
        <nav class="site-nav">
          <div class="nav-inner">
            <!-- 品牌标识不链接，不提供返回首页入口；子模块之间也不互相跳转 -->
            <span class="brand brand-static">
              <span class="logo logo-svg">
                <BrandMark size={32} />
              </span>
              <span>饮月听风</span>
            </span>
          </div>
        </nav>
      )
    }

    <slot />

    {
      mode === 'page' && (
        <footer class="site-footer">
          饮月听风 · 记录作品、旅途与电波
        </footer>
      )
    }

    <!-- 访问量统计（不蒜子） -->
    <div class="busuanzi-bar">
      <span id="busuanzi_container_today_pv">今日访问 <span id="busuanzi_value_today_pv"></span> 次</span>
      <span class="sep">·</span>
      <span id="busuanzi_container_site_pv">本站访问 <span id="busuanzi_value_site_pv"></span> 次</span>
      <span class="sep">·</span>
      <span id="busuanzi_container_today_uv">今日访客 <span id="busuanzi_value_today_uv"></span> 人</span>
      <span class="sep">·</span>
      <span id="busuanzi_container_site_uv">本站访客 <span id="busuanzi_value_site_uv"></span> 人</span>
    </div>

    <script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
    <script>
      // 不蒜子数据异步填充，等首个数值出现后再显示统计栏，避免闪现空数字
      (function () {
        var bar = document.querySelector('.busuanzi-bar');
        if (!bar) return;
        var targets = bar.querySelectorAll('span[id^="busuanzi_value"]');
        var revealed = false;
        var reveal = function () {
          if (revealed) return;
          revealed = true;
          bar.classList.add('busuanzi-loaded');
        };
        // 任一数值 span 出现非空文本即视为数据就绪
        var check = function () {
          for (var i = 0; i < targets.length; i++) {
            if (targets[i].textContent && targets[i].textContent.trim() !== '') {
              reveal();
              break;
            }
          }
        };
        var mo = new MutationObserver(check);
        targets.forEach(function (el) {
          mo.observe(el, { childList: true, characterData: true, subtree: true });
        });
        check();
        // 兜底：脚本加载失败/超时也显示占位（避免永久隐藏）
        setTimeout(reveal, 4000);
      })();
    </script>
  </body>
</html>
