---
// ThreeBackground.astro
// 宫崎骏风 · 夜晚月光首页场景
// 俯视角：林间柏油小路，小男孩骑机车缓行，车灯射光跟随鼠标（最大偏转 ±60°，共 120°）
---

<div class="three-bg" data-three-bg></div>

<style>
  .three-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
</style>

<script>
  import * as THREE from 'three';

  const mount = document.querySelector('[data-three-bg]');
  if (!mount) throw new Error('ThreeBackground mount not found');

  const width = mount.clientWidth;
  const height = mount.clientHeight;

  const scene = new THREE.Scene();

  // 俯视相机：从正上方往下看
  const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 200);
  camera.position.set(0, 0, 70);
  camera.lookAt(0, 0, 0);

  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
  renderer.setSize(width, height);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  mount.appendChild(renderer.domElement);

  // 视口范围（相机俯视下的可视区域）
  const viewH = 2 * 70 * Math.tan((45 * Math.PI) / 360);
  const viewW = viewH * (width / height);

  // ---- 1. 夜空底色（深蓝渐变，用一个大平面） ----
  const skyGeo = new THREE.PlaneGeometry(viewW * 3, viewH * 3);
  const skyMat = new THREE.ShaderMaterial({
    transparent: true,
    uniforms: {
      uTop: { value: new THREE.Color(0x0d1426) },
      uBottom: { value: new THREE.Color(0x1e2a4a) },
    },
    vertexShader: `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `,
    fragmentShader: `
      varying vec2 vUv;
      uniform vec3 uTop;
      uniform vec3 uBottom;
      void main() {
        vec3 c = mix(uBottom, uTop, vUv.y);
        gl_FragColor = vec4(c, 1.0);
      }
    `,
  });
  const sky = new THREE.Mesh(skyGeo, skyMat);
  sky.position.z = -10;
  scene.add(sky);

  // ---- 2. 林间柏油小路（竖直，从底部延伸到顶部） ----
  const roadW = 5.5;
  const roadGeo = new THREE.PlaneGeometry(roadW, viewH * 1.4);
  const roadMat = new THREE.MeshBasicMaterial({ color: 0x2a2e38 });
  const road = new THREE.Mesh(roadGeo, roadMat);
  road.position.y = -viewH * 0.1;
  scene.add(road);

  // 路面中线（虚线）
  const lineGeo = new THREE.PlaneGeometry(0.3, viewH * 1.4);
  const lineMat = new THREE.MeshBasicMaterial({ color: 0xd9b96a, transparent: true, opacity: 0.5 });
  const centerLine = new THREE.Mesh(lineGeo, lineMat);
  centerLine.position.y = -viewH * 0.1;
  scene.add(centerLine);

  // 路肩
  const shoulderMat = new THREE.MeshBasicMaterial({ color: 0x3a4152 });
  const shoulderL = new THREE.Mesh(new THREE.PlaneGeometry(0.6, viewH * 1.4), shoulderMat);
  shoulderL.position.set(-roadW / 2 - 0.3, -viewH * 0.1, 0);
  const shoulderR = new THREE.Mesh(new THREE.PlaneGeometry(0.6, viewH * 1.4), shoulderMat);
  shoulderR.position.set(roadW / 2 + 0.3, -viewH * 0.1, 0);
  scene.add(shoulderL, shoulderR);

  // ---- 3. 两侧树林（深色树冠，随机散布） ----
  const trees = new THREE.Group();
  const treeColors = [0x1a2a3d, 0x14202e, 0x1e3046, 0x16202c];
  const rng = mulberry32(20261115);
  for (let i = 0; i < 90; i++) {
    const side = rng() > 0.5 ? 1 : -1;
    const x = side * (roadW / 2 + 1.5 + rng() * (viewW / 2 - roadW / 2 - 2));
    const y = -viewH / 2 + rng() * viewH;
    const r = 1.2 + rng() * 2.2;
    const color = treeColors[Math.floor(rng() * treeColors.length)];
    const tree = new THREE.Mesh(
      new THREE.CircleGeometry(r, 24),
      new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.85 })
    );
    tree.position.set(x, y, 0);
    trees.add(tree);
  }
  scene.add(trees);

  // ---- 4. 月光与光晕 ----
  const moonGlow = new THREE.Mesh(
    new THREE.CircleGeometry(8, 32),
    new THREE.MeshBasicMaterial({ color: 0xf5e9c9, transparent: true, opacity: 0.06 })
  );
  moonGlow.position.set(viewW / 2 - 6, viewH / 2 - 5, -2);
  scene.add(moonGlow);

  const moonCore = new THREE.Mesh(
    new THREE.CircleGeometry(3.2, 32),
    new THREE.MeshBasicMaterial({ color: 0xf5e9c9, transparent: true, opacity: 0.9 })
  );
  moonCore.position.set(viewW / 2 - 6, viewH / 2 - 5, -2);
  scene.add(moonCore);

  // ---- 5. 机车（俯视，车头朝上 +Y） ----
  const bike = new THREE.Group();
  // 车身
  const body = new THREE.Mesh(
    new THREE.PlaneGeometry(2.2, 4.4),
    new THREE.MeshBasicMaterial({ color: 0x3b4f7e })
  );
  bike.add(body);
  // 车把/车头
  const head = new THREE.Mesh(
    new THREE.PlaneGeometry(2.4, 0.8),
    new THREE.MeshBasicMaterial({ color: 0xd9b96a })
  );
  head.position.y = 2.0;
  bike.add(head);
  // 前轮
  const wheelF = new THREE.Mesh(
    new THREE.CircleGeometry(0.9, 20),
    new THREE.MeshBasicMaterial({ color: 0x11151c })
  );
  wheelF.position.y = 2.6;
  bike.add(wheelF);
  // 后轮
  const wheelB = new THREE.Mesh(
    new THREE.CircleGeometry(0.9, 20),
    new THREE.MeshBasicMaterial({ color: 0x11151c })
  );
  wheelB.position.y = -2.4;
  bike.add(wheelB);
  // 骑手（小男孩，俯视圆头 + 身体）
  const rider = new THREE.Mesh(
    new THREE.CircleGeometry(0.7, 20),
    new THREE.MeshBasicMaterial({ color: 0xf5e9c9 })
  );
  rider.position.y = 0.4;
  bike.add(rider);

  // 车灯（发光点，位于车头）
  const headlight = new THREE.Mesh(
    new THREE.CircleGeometry(0.25, 16),
    new THREE.MeshBasicMaterial({ color: 0xffe9a8 })
  );
  headlight.position.y = 2.3;
  bike.add(headlight);

  bike.position.y = -viewH * 0.18; // 画面中下方
  scene.add(bike);

  // ---- 6. 车灯光束（锥形，从车头射出，跟随鼠标旋转） ----
  const beamGroup = new THREE.Group();
  const beamShape = new THREE.Shape();
  // 三角形光锥，顶点在车头，向 +Y 方向展开
  const beamLen = 22;
  const beamHalfW = 3.5;
  beamShape.moveTo(0, 0);
  beamShape.lineTo(-beamHalfW, beamLen);
  beamShape.lineTo(beamHalfW, beamLen);
  beamShape.closePath();
  const beamGeo = new THREE.ShapeGeometry(beamShape);
  const beamMat = new THREE.MeshBasicMaterial({
    color: 0xffe9a8,
    transparent: true,
    opacity: 0.28,
    side: THREE.DoubleSide,
    depthWrite: false,
  });
  const beam = new THREE.Mesh(beamGeo, beamMat);
  beamGroup.add(beam);
  // 光束核心（更亮的内层）
  const beamCoreShape = new THREE.Shape();
  beamCoreShape.moveTo(0, 0);
  beamCoreShape.lineTo(-beamHalfW * 0.4, beamLen);
  beamCoreShape.lineTo(beamHalfW * 0.4, beamLen);
  beamCoreShape.closePath();
  const beamCore = new THREE.Mesh(
    new THREE.ShapeGeometry(beamCoreShape),
    new THREE.MeshBasicMaterial({
      color: 0xfff3cc,
      transparent: true,
      opacity: 0.22,
      depthWrite: false,
    })
  );
  beamGroup.add(beamCore);

  beamGroup.position.set(bike.position.x, bike.position.y + 2.2, 0.1);
  scene.add(beamGroup);

  // ---- 鼠标跟随：车头与光束旋转，限制 ±60°（共 120°） ----
  const MAX_ANGLE = (Math.PI / 180) * 60; // 最大偏转 60°
  let targetAngle = 0;
  window.addEventListener('mousemove', (e) => {
    const nx = e.clientX / window.innerWidth - 0.5; // -0.5 ~ 0.5
    targetAngle = nx * 2 * MAX_ANGLE; // 映射到 ±60°
  });

  // 缓行：机车轻微前后呼吸
  let t = 0;
  let rafId = 0;
  function animate() {
    t += 0.01;

    // 光束平滑旋转到目标角度
    const current = beamGroup.rotation.z;
    beamGroup.rotation.z += (targetAngle - current) * 0.08;

    // 车头也轻微跟随（车头+车灯一起转）
    head.rotation.z = beamGroup.rotation.z * 0.5;
    headlight.rotation.z = beamGroup.rotation.z * 0.5;

    // 机车缓行呼吸（轻微位移）
    bike.position.y = -viewH * 0.18 + Math.sin(t) * 0.15;

    // 树影轻微摆动
    trees.rotation.z = Math.sin(t * 0.5) * 0.002;

    renderer.render(scene, camera);
    rafId = requestAnimationFrame(animate);
  }
  animate();

  // ---- 响应式 ----
  window.addEventListener('resize', () => {
    const w = mount.clientWidth;
    const h = mount.clientHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
  });

  // 减少移动端开销
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    cancelAnimationFrame(rafId);
    renderer.render(scene, camera);
  }

  // 可复现随机数
  function mulberry32(seed) {
    return function () {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
</script>
