---
/**
 * 品牌标识：深藏青圆角方块 + 白色「月风」竖排楷体。
 * 与 public/favicon.svg 完全同一份字形与坐标，改这里时请同步改 favicon，
 * 否则导航图标与浏览器标签页图标会不一致。
 */
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg
  viewBox="0 0 128 128"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <rect width="128" height="128" rx="28" fill="#1E2A4A"></rect>
  <g
    fill="#FFFFFF"
    text-anchor="middle"
    font-family="'LXGW WenKai','霞鹜文楷','Kaiti SC','KaiTi','STKaiti','楷体',serif"
  >
    <text x="64" y="62" font-size="46" font-weight="500">月</text>
    <text x="64" y="110" font-size="46" font-weight="500">风</text>
  </g>
</svg>
