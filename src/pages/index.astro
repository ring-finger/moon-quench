---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="饮月听风 · BA4IWA" mode="home">
  <main class="home">
    <section class="card">
      <span class="badge badge-brand">饮月听风</span>
      <p class="intro">一个安静的个人角落，记录作品、旅途与电波。</p>

      <div class="qrcode">
        <img src={`${base}qrcode-gzh.jpg`} alt="微信公众号「饮月听风」二维码" width="220" height="220" />
        <p class="qr-hint">扫码关注「饮月听风」公众号</p>
      </div>

      <div class="contact">
        <p class="c-row">
          <span class="c-label">邮箱</span>
          <a class="c-value" href="mailto:minionzw@163.com">minionzw@163.com</a>
        </p>
        <p class="c-row">
          <span class="c-label">呼号</span>
          <span class="c-value">BA4IWA</span>
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .home {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .card {
    width: 100%;
    max-width: 400px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    padding: 40px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .badge {
    font-family: var(--font-kai);
  }

  .name {
    font-family: var(--font-kai);
    font-size: 34px;
    font-weight: 600;
    letter-spacing: 4px;
    color: var(--navy);
  }

  .intro {
    font-family: var(--font-kai);
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--text-soft);
  }

  .qrcode {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .qrcode img {
    width: 220px;
    height: 220px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .qr-hint {
    font-family: var(--font-kai);
    font-size: 13px;
    color: var(--text-faint);
    letter-spacing: 1px;
  }

  .contact {
    width: 100%;
    margin-top: 12px;
    border-top: 1px solid var(--border-soft);
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .c-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 14px;
  }

  .c-label {
    color: var(--text-faint);
    font-family: var(--font-kai);
    letter-spacing: 1px;
    flex-shrink: 0;
  }

  .c-value {
    color: var(--navy);
    font-weight: 500;
    font-family: var(--font-sans);
    letter-spacing: 0.5px;
  }

  a.c-value:hover {
    color: var(--gold);
  }
</style>
