---
import Layout from '../layouts/Layout.astro';
import ThreeBackground from '../components/ThreeBackground.astro';

const base = import.meta.env.BASE_URL;

const modules = [
  {
    href: `${base}blog`,
    title: '灵犀小筑',
    en: 'Thoughts',
    icon: '✍️',
    desc: '灵犀一点，落笔成篇',
  },
  {
    href: `${base}travel`,
    title: '旅游小记',
    en: 'Journeys',
    icon: '🗺️',
    desc: '山水行迹，且行且记',
  },
  {
    href: `${base}radio`,
    title: '无线电波',
    en: 'Airwaves',
    icon: '📡',
    desc: '天地电波，远方回声',
  },
];
---

<Layout title="月风 · 个人小站" mode="home">
  <main class="home">
    <ThreeBackground />

    <section class="hero">
      <span class="badge badge-brand">山间有月 · 风里听泉</span>
      <h1 class="brand-title">
        <span>月</span><span>风</span>
      </h1>
      <p class="hero-sub">记录作品、旅途与电波，一个安静的角落</p>
    </section>

    <section class="modules">
      {
        modules.map((m) => (
          <a
            class="module-card fade-in"
            href={m.href}
            target="_blank"
            rel="noopener"
          >
            <span class="m-icon">{m.icon}</span>
            <h2>{m.title}</h2>
            <p>{m.desc}</p>
            <span class="m-enter">进入 →</span>
          </a>
        ))
      }
    </section>
  </main>
</Layout>

<style>
  .home {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .hero {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 90px 24px 30px;
    pointer-events: none;
  }

  .hero .badge {
    pointer-events: auto;
  }

  .brand-title {
    display: flex;
    justify-content: center;
    gap: 18px;
    margin: 30px 0 14px;
    font-family: var(--font-kai);
    font-weight: 500;
  }

  .brand-title span {
    font-size: 72px;
    line-height: 1;
    color: var(--moon);
    text-shadow: 0 2px 24px rgba(245, 233, 201, 0.35);
    letter-spacing: 4px;
  }

  .hero-sub {
    font-size: 16px;
    color: rgba(245, 233, 201, 0.75);
    letter-spacing: 2px;
    font-family: var(--font-kai);
  }

  .modules {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 30px 24px 90px;
    max-width: 1120px;
    width: 100%;
    margin: 0 auto;
  }

  .module-card {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(245, 233, 201, 0.18);
    border-radius: var(--radius);
    padding: 40px 32px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
  }

  .module-card:hover {
    transform: translateY(-6px);
    border-color: rgba(217, 185, 106, 0.55);
    background: rgba(255, 255, 255, 0.14);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);
  }

  .m-icon {
    font-size: 40px;
    line-height: 1;
  }

  .module-card h2 {
    font-size: 24px;
    font-weight: 600;
    color: var(--moon);
    font-family: var(--font-kai);
    letter-spacing: 2px;
  }

  .module-card p {
    font-size: 14px;
    color: rgba(245, 233, 201, 0.7);
    flex: 1;
    font-family: var(--font-kai);
    letter-spacing: 1px;
  }

  .m-enter {
    font-size: 14px;
    font-weight: 600;
    color: var(--gold);
    opacity: 0;
    transform: translateX(-6px);
    transition: all 0.3s;
  }

  .module-card:hover .m-enter {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 768px) {
    .hero { padding: 70px 24px 20px; }
    .brand-title span { font-size: 52px; }
    .modules { grid-template-columns: 1fr; padding-bottom: 70px; }
  }
</style>

<script>
  // 入场动画：滚动进入视口时淡入
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.2 }
  );
  document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));
</script>
