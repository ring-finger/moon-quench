---
import Layout from '../layouts/Layout.astro';
import ThreeBackground from '../components/ThreeBackground.astro';

const base = import.meta.env.BASE_URL;

const modules = [
  {
    href: `${base}blog`,
    title: '灵犀小筑',
    en: 'THOUGHTS',
    desc: '灵犀一点，落笔成篇',
  },
  {
    href: `${base}travel`,
    title: '旅游小记',
    en: 'JOURNEYS',
    desc: '山水行迹，且行且记',
  },
  {
    href: `${base}radio`,
    title: '无线电波',
    en: 'AIRWAVES',
    desc: '天地电波，远方回声',
  },
];
---

<Layout title="饮月听风 · 个人小站" mode="home">
  <main class="home">
    <ThreeBackground />

    <section class="hero">
      <span class="badge badge-brand">闲时饮月 · 醉后听风</span>
      <h1 class="brand-title">
        <span>饮月</span><span>听风</span>
      </h1>
      <p class="hero-sub">记录作品、旅途与电波，一个安静的角落</p>
    </section>

    <section class="modules">
      {
        modules.map((m) => (
          <a class="module-card fade-in" href={m.href}>
            <span class="m-en">{m.en}</span>
            <h2>{m.title}</h2>
            <p>{m.desc}</p>
            <span class="m-enter">进入 →</span>
          </a>
        ))
      }
    </section>
  </main>
</Layout>

<style>
  .home {
    position: relative;
    min-height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .hero {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 58px 24px 20px;
    pointer-events: none;
  }

  .hero .badge {
    pointer-events: auto;
  }

  .brand-title {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin: 22px 0 10px;
    font-family: var(--font-kai);
    font-weight: 500;
  }

  .brand-title span {
    font-size: 58px;
    line-height: 1;
    color: var(--moon);
    text-shadow: 0 2px 24px rgba(245, 233, 201, 0.35);
    letter-spacing: 4px;
  }

  .hero-sub {
    font-size: 14px;
    color: rgba(245, 233, 201, 0.7);
    letter-spacing: 2px;
    font-family: var(--font-kai);
  }

  .modules {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding: 0 24px 34px;
    max-width: 780px;
    width: 100%;
    /* 推到画面底部，不遮挡中部的竹屋与石桌 */
    margin: auto auto 0;
  }

  .module-card {
    background: rgba(12, 20, 34, 0.28);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(245, 233, 201, 0.12);
    border-radius: var(--radius-sm);
    padding: 18px 20px 16px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.22);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    gap: 7px;
    position: relative;
  }

  .module-card:hover {
    transform: translateY(-4px);
    border-color: rgba(217, 185, 106, 0.45);
    background: rgba(20, 32, 52, 0.46);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.32);
  }

  .module-card:active {
    transform: translateY(-1px) scale(0.98);
  }

  .m-en {
    font-size: 10px;
    letter-spacing: 3px;
    color: rgba(217, 185, 106, 0.62);
    text-transform: uppercase;
    font-family: var(--font-sans);
    display: flex;
    align-items: center;
    gap: 8px;
    transition: color 0.3s;
  }

  .m-en::before {
    content: '';
    width: 16px;
    height: 1px;
    background: rgba(217, 185, 106, 0.5);
    transition: all 0.3s;
  }

  .module-card:hover .m-en {
    color: var(--gold);
  }

  .module-card:hover .m-en::before {
    width: 26px;
    background: var(--gold);
  }

  .module-card h2 {
    font-size: 18px;
    font-weight: 600;
    color: var(--moon);
    font-family: var(--font-kai);
    letter-spacing: 2px;
  }

  .module-card p {
    font-size: 12px;
    color: rgba(245, 233, 201, 0.6);
    flex: 1;
    font-family: var(--font-kai);
    letter-spacing: 1px;
    line-height: 1.5;
  }

  .m-enter {
    font-size: 12px;
    font-weight: 600;
    color: var(--gold);
    opacity: 0;
    transform: translateX(-6px);
    transition: all 0.3s;
  }

  .module-card:hover .m-enter {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 768px) {
    .hero { padding: 44px 20px 16px; }
    .brand-title span { font-size: 42px; }
    .modules { grid-template-columns: 1fr; padding: 0 18px 24px; gap: 10px; }
  }
</style>

<script>
  // 入场动画：滚动进入视口时淡入
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.2 }
  );
  document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));
</script>
