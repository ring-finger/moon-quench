---
import Layout from '../../layouts/Layout.astro';
import RadioTabs from '../../components/RadioTabs.astro';

// 摩尔斯电码字母表（用于图文记忆网格）
const morseTable = [
  { ch: 'A', code: '·−' }, { ch: 'B', code: '−···' }, { ch: 'C', code: '−·−·' },
  { ch: 'D', code: '−··' }, { ch: 'E', code: '·' }, { ch: 'F', code: '··−·' },
  { ch: 'G', code: '−−·' }, { ch: 'H', code: '····' }, { ch: 'I', code: '··' },
  { ch: 'J', code: '·−−−' }, { ch: 'K', code: '−·−' }, { ch: 'L', code: '·−··' },
  { ch: 'M', code: '−−' }, { ch: 'N', code: '−·' }, { ch: 'O', code: '−−−' },
  { ch: 'P', code: '·−−·' }, { ch: 'Q', code: '−−·−' }, { ch: 'R', code: '·−·' },
  { ch: 'S', code: '···' }, { ch: 'T', code: '−' }, { ch: 'U', code: '··−' },
  { ch: 'V', code: '···−' }, { ch: 'W', code: '·−−' }, { ch: 'X', code: '−··−' },
  { ch: 'Y', code: '−·−−' }, { ch: 'Z', code: '−−··' },
];

// 数字电码
const morseNumbers = [
  { ch: '0', code: '−−−−−' }, { ch: '1', code: '·−−−−' }, { ch: '2', code: '··−−−' },
  { ch: '3', code: '···−−' }, { ch: '4', code: '····−' }, { ch: '5', code: '·····' },
  { ch: '6', code: '−····' }, { ch: '7', code: '−−···' }, { ch: '8', code: '−−−··' },
  { ch: '9', code: '−−−−·' },
];
---

<Layout title="摩尔斯电码 · 饮月听风">
  <main class="container page">
    <span class="badge badge-brand">无线电波</span>
    <h1 class="page-title">摩尔斯电码</h1>
    <p class="page-desc">读 → 听 → 发，三阶递进的学习方法</p>

    <div class="radio-tabs-row">
      <RadioTabs active="morse" />
    </div>

    <!-- 字母电码 -->
    <div class="cw-card">
      <div class="cw-card-head">
        <div class="cw-head-main">
          <h3>字母电码</h3>
          <p>把点（·，读作「嘀」，短促）与划（−，读作「哒」，拉长）记成节奏，而非死记符号</p>
        </div>
        <button type="button" class="cw-shuffle" data-shuffle="grid-letters" title="随机打乱字母顺序">⇄ 乱序</button>
      </div>
      <div class="cw-grid" id="grid-letters" role="list">
        {
          morseTable.map((m) => (
            <button
              type="button"
              class="cw-cell"
              role="listitem"
              data-morse={m.code.replaceAll('·', '.').replaceAll('−', '-')}
              aria-label={`${m.ch} 的摩尔斯电码 ${m.code}，点击播放`}
            >
              <span class="cw-ch">{m.ch}</span>
              <span class="cw-code">{m.code}</span>
            </button>
          ))
        }
      </div>
      <p class="cw-tip">读码口诀：<b>嘀短 · 哒长</b>，点划长度比约 1 : 3，点击字母即可试听</p>
    </div>

    <!-- 数字电码 -->
    <div class="cw-card">
      <div class="cw-card-head">
        <div class="cw-head-main">
          <h3>数字电码</h3>
          <p>0–9 数字的对应电码，常用于呼号与信号报告</p>
        </div>
        <button type="button" class="cw-shuffle" data-shuffle="grid-numbers" title="随机打乱数字顺序">⇄ 乱序</button>
      </div>
      <div class="cw-grid" id="grid-numbers" role="list">
        {
          morseNumbers.map((n) => (
            <button
              type="button"
              class="cw-cell"
              role="listitem"
              data-morse={n.code.replaceAll('·', '.').replaceAll('−', '-')}
              aria-label={`${n.ch} 的摩尔斯电码 ${n.code}，点击播放`}
            >
              <span class="cw-ch">{n.ch}</span>
              <span class="cw-code">{n.code}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- 学习三步 -->
    <div class="cw-steps">
      <div class="cw-step">
        <span class="cw-step-no">壹</span>
        <div class="cw-step-body">
          <h4>背电码 · 打好基础</h4>
          <p>点读「嘀」要快，划读「哒」要拉长。先能看着字母顺利读出电码，再进入下一阶段。</p>
          <div class="cw-step-tags">
            <span>嘀 = ·</span><span>哒 = −</span>
          </div>
        </div>
      </div>

      <div class="cw-step">
        <span class="cw-step-no">贰</span>
        <div class="cw-step-body">
          <h4>读电码 · 眼手同步</h4>
          <p>手指跟随字母逐位移动，眼睛看着字符，大声读出对应电码。经历「缓慢 → 迅速 → 平稳」三小阶段。</p>
          <div class="cw-step-tags">
            <span>眼跟手</span><span>抢读即慢</span>
          </div>
        </div>
      </div>

      <div class="cw-step">
        <span class="cw-step-no">叁</span>
        <div class="cw-step-body">
          <h4>听码 · 抄听训练</h4>
          <p>多听电脑正规报，用「听」建立节奏感而非「数」点划。先慢后快，循序渐进。</p>
          <div class="cw-step-tags">
            <span>多听正规报</span><span>先慢后快</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 发报拓展 -->
    <div class="cw-card cw-extra">
      <h3>进阶 · 手键发报要领</h3>
      <p>
        点划时间比例 1 : 3，字符间隔 3 点、组间隔 7 点；讲究平稳准确，宁稳勿快。
        完整要领（坐姿、握键、用力、防坏手）请见——
      </p>
      <a
        class="cw-link"
        href="https://www.meipian.cn/3yh5dzxu?share_depth=2&s_uid=519667058&share_to=group_singlemessage&first_share_to=group_singlemessage&first_share_uid=31309831"
        target="_blank"
        rel="noopener noreferrer"
      >
        《摩尔斯电码手键拍发要领》· BA4II
        <span class="cw-link-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- WPM 解释与建议 -->
    <div class="cw-card cw-wpm">
      <div class="cw-card-head">
        <h3>WPM · 电码速度</h3>
        <p>衡量摩尔斯收发快慢的标准单位，读码与发报都以此对标</p>
      </div>

      <p class="cw-wpm-lead">
        <b>WPM（Words Per Minute）</b>，即「每分钟字数」。以标准词 <b>“PARIS”</b> 为基准，
        一个 PARIS 对应 50 个时间单位，故 1 WPM ≈ 每分钟传送一个标准词。
      </p>

      <div class="cw-wpm-levels">
        <div class="cw-wpm-lv">
          <span class="cw-wpm-num">5 WPM</span>
          <p>起步速度，适合初学背码后第一次抄听，节奏慢、容错高。</p>
        </div>
        <div class="cw-wpm-lv">
          <span class="cw-wpm-num">10–15 WPM</span>
          <p>常规通联速度，多数日常 QSO 在此区间，可稳定抄收呼号与信号报告。</p>
        </div>
        <div class="cw-wpm-lv">
          <span class="cw-wpm-num">20+ WPM</span>
          <p>进阶速度，适合比赛与快速通联，需长期听码训练积累「节奏感」。</p>
        </div>
      </div>

      <ul class="cw-wpm-tips">
        <li><b>宁慢勿快</b>：先保证每个字符都听清、抄准，再逐步提速，切勿一开始就求快。</li>
        <li><b>节奏优先</b>：用「听」感受点划的间隔与韵律，而不是去「数」点划的个数。</li>
        <li><b>固定间隔</b>：字符间隔 3 点、词组间隔 7 点，先按规范节奏练，再追求速度。</li>
      </ul>
    </div>

    <p class="cw-credit">开发 · BA4IWA　/　摩尔斯码内容支持 · BI4JVV　BI4MPY</p>
  </main>
</Layout>

<script>
  // 摩尔斯电码合成：点 · 短音，划 - 长音（Web Audio API，无需音频文件）
  (() => {
    const FREQ = 700;      // 音频频率（Hz）
    const WPM = 18;        // 速度，决定点划时长
    const UNIT = 1.2 / WPM; // 一个「点」的时长（秒）
    const DOT = UNIT;
    const DASH = UNIT * 3;   // 划 = 3 点
    const GAP = UNIT;        // 点划之间间隔 = 1 点
    const CHAR_GAP = UNIT * 3; // 字符间隔 = 3 点

    let ctx = null;

    function getCtx() {
      if (!ctx) {
        ctx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (ctx.state === 'suspended') ctx.resume();
      return ctx;
    }

    // 播放一段持续 tone 的正弦音，带 5ms 淡入淡出避免爆音
    function beep(ctx, duration, startAt) {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.value = FREQ;

      const t0 = ctx.currentTime + startAt;
      gain.gain.setValueAtTime(0.0001, t0);
      gain.gain.exponentialRampToValueAtTime(0.6, t0 + 0.005);
      gain.gain.setValueAtTime(0.6, t0 + duration - 0.005);
      gain.gain.exponentialRampToValueAtTime(0.0001, t0 + duration);

      osc.connect(gain).connect(ctx.destination);
      osc.start(t0);
      osc.stop(t0 + duration + 0.01);
    }

    function playMorse(code) {
      const c = getCtx();
      let t = 0;
      for (const sym of code) {
        if (sym === '.') {
          beep(c, DOT, t);
          t += DOT + GAP;
        } else if (sym === '-') {
          beep(c, DASH, t);
          t += DASH + GAP;
        }
      }
    }

    const cells = document.querySelectorAll('.cw-cell[data-morse]');
    cells.forEach((cell) => {
      cell.addEventListener('click', () => {
        const code = cell.getAttribute('data-morse');
        if (code) playMorse(code);

        // 播放态高亮反馈
        cell.classList.add('is-playing');
        setTimeout(() => cell.classList.remove('is-playing'), 300);
      });
    });
  })();

  // 乱序：点击「乱序」按钮，打乱对应网格内卡片顺序（Fisher-Yates，每次随机）
  (() => {
    document.querySelectorAll('.cw-shuffle[data-shuffle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const grid = document.getElementById(btn.getAttribute('data-shuffle'));
        if (!grid) return;

        const cells = Array.from(grid.children);
        // Fisher-Yates 洗牌
        for (let i = cells.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [cells[i], cells[j]] = [cells[j], cells[i]];
        }
        // 重新按新顺序挂回 DOM
        cells.forEach((cell) => grid.appendChild(cell));

        // 按钮短促反馈
        btn.classList.add('is-shuffling');
        setTimeout(() => btn.classList.remove('is-shuffling'), 300);
      });
    });
  })();
</script>

<style>
  .radio-tabs-row {
    margin-bottom: 28px;
  }

  .cw-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    padding: 22px 24px 24px;
    margin-bottom: 20px;
  }

  .cw-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .cw-head-main {
    flex: 1;
    min-width: 0;
  }

  .cw-card-head h3 {
    font-family: var(--font-kai);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--navy);
  }

  .cw-card-head p {
    margin-top: 6px;
    font-size: 13px;
    color: var(--text-soft);
  }

  /* 乱序按钮 */
  .cw-shuffle {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--navy);
    font-family: var(--font-kai);
    font-size: 13px;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .cw-shuffle:hover {
    border-color: var(--gold);
    color: var(--gold);
    box-shadow: var(--shadow-sm);
  }

  .cw-shuffle:active {
    transform: scale(0.96);
  }

  .cw-shuffle:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .cw-shuffle.is-shuffling {
    border-color: var(--gold);
    background: color-mix(in srgb, var(--gold) 20%, #fff);
    color: var(--navy);
  }

  /* 图文记忆网格 */
  .cw-grid {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    gap: 10px;
  }

  .cw-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 14px 8px 12px;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm);
    background: #fbfdfe;
    font: inherit;
    color: inherit;
    cursor: pointer;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cw-cell:hover {
    border-color: var(--gold);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    background: #fffdf9;
  }

  .cw-cell:active {
    transform: translateY(-1px) scale(0.97);
  }

  .cw-cell:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .cw-cell.is-playing {
    border-color: var(--gold);
    background: color-mix(in srgb, var(--gold) 22%, #fff);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--gold) 28%, transparent);
  }

  .cw-ch {
    font-family: var(--font-kai);
    font-size: 26px;
    font-weight: 700;
    line-height: 1;
    color: var(--navy);
  }

  .cw-code {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #000;
    white-space: nowrap;
  }

  .cw-tip {
    margin-top: 16px;
    font-family: var(--font-kai);
    font-size: 13.5px;
    letter-spacing: 0.5px;
    color: var(--text-soft);
    text-align: center;
  }

  .cw-tip b {
    color: var(--gold);
    letter-spacing: 1px;
  }

  /* 学习三步 */
  .cw-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 20px;
  }

  .cw-step {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 20px 20px 22px;
    position: relative;
    overflow: hidden;
  }

  .cw-step::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--grad-brand);
  }

  .cw-step-no {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--moon-2);
    font-family: var(--font-kai);
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .cw-step-body h4 {
    font-family: var(--font-kai);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--navy);
  }

  .cw-step-body p {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-soft);
  }

  .cw-step-tags {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cw-step-tags span {
    font-family: var(--font-kai);
    font-size: 12px;
    letter-spacing: 0.5px;
    padding: 3px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--gold) 16%, #fff);
    border: 1px solid color-mix(in srgb, var(--gold) 50%, #fff);
    color: var(--navy-2);
  }

  /* 发报拓展 */
  .cw-extra {
    background: linear-gradient(135deg, #fbfdfe 0%, #fffdf9 100%);
  }

  .cw-extra h3 {
    font-family: var(--font-kai);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--navy);
  }

  .cw-extra p {
    margin-top: 8px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--text-soft);
  }

  .cw-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--navy);
    color: var(--moon-2);
    font-family: var(--font-kai);
    font-size: 14px;
    letter-spacing: 1px;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cw-link:hover {
    background: var(--navy-2);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .cw-link:active {
    transform: translateY(0) scale(0.98);
  }

  .cw-link-arrow {
    transition: transform 0.22s ease;
  }

  .cw-link:hover .cw-link-arrow {
    transform: translateX(3px);
  }

  /* WPM 电码速度 */
  .cw-wpm {
    margin-top: 20px;
  }

  .cw-wpm-lead {
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-soft);
  }

  .cw-wpm-lead b {
    color: var(--navy);
    font-weight: 700;
  }

  .cw-wpm-levels {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .cw-wpm-lv {
    padding: 14px 16px;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm);
    background: #fbfdfe;
  }

  .cw-wpm-num {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 16px;
    letter-spacing: 0.5px;
    color: var(--gold);
  }

  .cw-wpm-lv p {
    margin-top: 8px;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--text-soft);
  }

  .cw-wpm-tips {
    margin-top: 18px;
    padding-left: 20px;
    list-style: none;
  }

  .cw-wpm-tips li {
    position: relative;
    padding-left: 18px;
    margin-bottom: 10px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--text-soft);
  }

  .cw-wpm-tips li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
  }

  .cw-wpm-tips li b {
    color: var(--navy);
  }

  /* 技术支持署名 */
  .cw-credit {
    margin-top: 28px;
    text-align: center;
    font-family: var(--font-kai);
    font-size: 13px;
    letter-spacing: 1.5px;
    color: var(--text-faint);
  }

  @media (max-width: 768px) {
    .cw-card {
      padding: 18px 16px 20px;
    }

    .cw-shuffle {
      padding: 5px 11px;
      font-size: 12px;
    }

    .cw-grid {
      grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
      gap: 8px;
    }

    .cw-ch {
      font-size: 22px;
    }

    .cw-code {
      font-size: 14px;
      letter-spacing: 1px;
    }

    .cw-steps {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .cw-wpm-levels {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
