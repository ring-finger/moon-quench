---
import Layout from '../layouts/Layout.astro';
import RadioTabs from '../components/RadioTabs.astro';
// 带 data-rg 标记的分区图（由 scripts/prep-radio-map.mjs 生成）
import rawMap from '../assets/radio-map.rg.svg?raw';

const mapSvg = rawMap.replace(
  '<svg ',
  '<svg class="map-svg" role="img" aria-label="中国业余无线电呼号分区图，第 0 至 9 区，可按大区查看" '
);

// 大区数据：色值取自原图图例，用于信息条上的区号着色
const regions = [
  { rg: 1, prefix: 'B1', color: '#e74c3c', provinces: ['北京'] },
  { rg: 2, prefix: 'B2', color: '#5499c7', provinces: ['黑龙江', '吉林', '辽宁'] },
  { rg: 3, prefix: 'B3', color: '#f0cf4a', provinces: ['天津', '内蒙古', '河北', '山西'] },
  { rg: 4, prefix: 'B4', color: '#58d68d', provinces: ['上海', '山东', '江苏'] },
  { rg: 5, prefix: 'B5', color: '#af7ac5', provinces: ['浙江', '江西', '福建'] },
  { rg: 6, prefix: 'B6', color: '#f5b041', provinces: ['安徽', '河南', '湖北'] },
  { rg: 7, prefix: 'B7', color: '#a2d9ce', provinces: ['湖南', '广东', '广西', '海南'] },
  { rg: 8, prefix: 'B8', color: '#ec7063', provinces: ['四川', '重庆', '贵州', '云南'] },
  { rg: 9, prefix: 'B9', color: '#7fb3d5', provinces: ['陕西', '甘肃', '宁夏', '青海'] },
  { rg: 0, prefix: 'B0', color: '#e6b17e', provinces: ['新疆', '西藏'] },
];
---

<Layout title="无线电波 · 饮月听风" active="radio">
  <main class="container page">
    <span class="badge badge-brand">无线电波</span>
    <h1 class="page-title">无线电波</h1>
    <p class="page-desc">中国业余无线电呼号分区地图</p>

    <div class="radio-tabs-row">
      <RadioTabs active="map" />
    </div>

    <div class="map-card">
      <div class="map-stage-head">
        <button class="fullscreen-btn" type="button" aria-label="横屏全屏查看地图">
          <span class="fs-icon" aria-hidden="true"></span>
          <span>横屏查看</span>
        </button>
      </div>
      <div class="map-stage" set:html={mapSvg}></div>

      <div class="map-fullscreen" hidden>
        <div class="fs-topbar">
          <span class="fs-title">中国业余无线电呼号分区图</span>
          <button class="fs-close" type="button" aria-label="退出横屏查看">
            <span class="fs-close-x" aria-hidden="true"></span>
          </button>
        </div>
        <div class="fs-stage" set:html={mapSvg}></div>
        <p class="fs-hint">点击地图可查看大区，点击右上角关闭</p>
      </div>

      <div class="region-bar">
        <div class="rb-picker" role="group" aria-label="按大区查看">
          {
            regions.map((r) => (
              <button
                class="rb-pick"
                type="button"
                data-rg={r.rg}
                style={`--rgc:${r.color}`}
                aria-label={`第 ${r.rg} 区：${r.provinces.join('、')}`}
              >
                {r.rg}
              </button>
            ))
          }
        </div>

        <div class="rb-info is-empty" aria-live="polite">
          <p class="rb-hint">把鼠标移到地图上的省份或右侧图例，也可以点下方区号</p>
        </div>
      </div>
    </div>

    <p class="map-note">
      依据工信部《业余无线电台呼号管理办法》附件二「业余无线电台分区表」绘制，
      仅示意呼号分区，不作疆界依据。
    </p>
  </main>
</Layout>

<style>
  .radio-tabs-row {
    margin-bottom: 28px;
  }

  /* ---------- 地图卡片 ---------- */
  .map-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .map-stage-head {
    display: flex;
    justify-content: flex-end;
    padding: 10px 14px 0;
  }

  .fullscreen-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: #fff;
    font-family: var(--font-kai);
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--navy-2);
    cursor: pointer;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fullscreen-btn:hover {
    border-color: var(--gold);
    color: var(--navy);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(30, 42, 74, 0.12);
  }

  .fullscreen-btn:active {
    transform: translateY(0) scale(0.97);
  }

  .fs-icon {
    position: relative;
    width: 13px;
    height: 11px;
    border: 1.5px solid currentColor;
    border-radius: 2px;
  }

  .fs-icon::before,
  .fs-icon::after {
    content: '';
    position: absolute;
    width: 5px;
    height: 5px;
    border-style: solid;
    border-color: currentColor;
  }

  .fs-icon::before {
    top: -2px;
    left: -2px;
    border-width: 1.5px 0 0 1.5px;
  }

  .fs-icon::after {
    bottom: -2px;
    right: -2px;
    border-width: 0 1.5px 1.5px 0;
  }

  .map-stage {
    padding: 14px 14px 10px;
    background: #fbfdfe;
  }

  .map-stage :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
  }

  /* ---------- 交互：悬停高亮 ---------- */
  /* 省名文字、引线、锚点不拦截鼠标，否则指向它们时收不到 region */
  .map-stage :global(.map-svg text),
  .map-stage :global(.map-svg line),
  .map-stage :global(.map-svg circle) {
    pointer-events: none;
  }

  .map-stage :global(.map-svg [data-rg]) {
    cursor: pointer;
    transition: opacity 0.22s ease, filter 0.22s ease, stroke 0.22s ease;
  }

  /* 有选中区时，其余区退到背景 */
  .map-stage :global(.map-svg.is-focus [data-rg]) {
    opacity: 0.22;
  }

  .map-stage :global(.map-svg [data-rg].on) {
    opacity: 1;
    /* 两层：外圈微光让北京这类极小区域也能看见，下方投影给出浮起感 */
    filter: saturate(1.32) drop-shadow(0 0 3px rgba(20, 36, 58, 0.5))
      drop-shadow(0 3px 6px rgba(18, 32, 56, 0.26));
  }

  /* 只给省份轮廓描边，图例小色块不加 */
  .map-stage :global(.map-svg path.on) {
    stroke: #14243a;
    stroke-width: 2.6;
    stroke-linejoin: round;
    paint-order: stroke;
  }

  /* ---------- 底部：区号选择 + 说明 ---------- */
  .region-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding: 14px 18px 16px;
    border-top: 1px solid var(--border-soft);
    background: #fffdf9;
  }

  .rb-picker {
    display: flex;
    gap: 6px;
  }

  .rb-pick {
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: #fff;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-soft);
    cursor: pointer;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rb-pick:hover {
    border-color: var(--rgc);
    color: var(--navy);
    transform: translateY(-2px);
  }

  .rb-pick:active {
    transform: translateY(0) scale(0.9);
  }

  .rb-pick.active {
    background: var(--rgc);
    border-color: var(--rgc);
    color: #1b2631;
    box-shadow: 0 4px 12px rgba(30, 42, 74, 0.18);
  }

  .rb-info {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 40px;
  }

  .rb-hint {
    font-family: var(--font-kai);
    font-size: 13px;
    letter-spacing: 0.5px;
    color: var(--text-faint);
  }

  .rb-no {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--rgc) 22%, #fff);
    border: 1px solid var(--rgc);
    font-family: var(--font-kai);
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
    color: var(--navy);
  }

  .rb-meta {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .rb-meta b {
    font-family: var(--font-kai);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--navy);
  }

  .rb-meta i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.5px;
    color: var(--text-faint);
  }

  .rb-prov {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-width: 0;
  }

  .rb-chip {
    font-family: var(--font-kai);
    font-size: 12.5px;
    letter-spacing: 0.5px;
    padding: 3px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--rgc) 14%, #fff);
    border: 1px solid color-mix(in srgb, var(--rgc) 55%, #fff);
    color: var(--navy-2);
  }

  /* ---------- 横屏全屏查看 ---------- */
  :global(body.fs-open) {
    overflow: hidden;
  }

  .map-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    background: #0d1726;
  }

  .map-fullscreen[hidden] {
    display: none;
  }

  .fs-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    color: #e8edf3;
  }

  .fs-title {
    font-family: var(--font-kai);
    font-size: 15px;
    letter-spacing: 1.5px;
    color: var(--gold);
  }

  .fs-close {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.06);
    cursor: pointer;
    transition: all 0.22s ease;
  }

  .fs-close:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .fs-close:active {
    transform: scale(0.92);
  }

  .fs-close-x {
    position: relative;
    width: 16px;
    height: 16px;
  }

  .fs-close-x::before,
  .fs-close-x::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 16px;
    height: 1.5px;
    background: #e8edf3;
    border-radius: 1px;
  }

  .fs-close-x::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .fs-close-x::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .fs-stage {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px 10px;
    overflow: hidden;
  }

  .fs-stage :global(svg) {
    width: auto;
    height: 100%;
    max-width: none;
    display: block;
    border-radius: 6px;
  }

  /* 竖屏手机：自动把地图旋转 90°，铺满横屏视角，无需手动转手机 */
  @media (orientation: portrait) {
    .fs-stage :global(svg) {
      width: auto;
      height: 100vw;
      max-width: none;
      transform: rotate(90deg);
    }

    .fs-hint {
      display: none;
    }
  }

  /* 全屏态也复用悬停/选中的高亮规则 */
  .fs-stage :global(.map-svg text),
  .fs-stage :global(.map-svg line),
  .fs-stage :global(.map-svg circle) {
    pointer-events: none;
  }

  .fs-stage :global(.map-svg [data-rg]) {
    cursor: pointer;
    transition: opacity 0.22s ease, filter 0.22s ease, stroke 0.22s ease;
  }

  .fs-stage :global(.map-svg.is-focus [data-rg]) {
    opacity: 0.22;
  }

  .fs-stage :global(.map-svg [data-rg].on) {
    opacity: 1;
    filter: saturate(1.32) drop-shadow(0 0 3px rgba(20, 36, 58, 0.5))
      drop-shadow(0 3px 6px rgba(18, 32, 56, 0.26));
  }

  .fs-stage :global(.map-svg path.on) {
    stroke: #14243a;
    stroke-width: 2.6;
    stroke-linejoin: round;
    paint-order: stroke;
  }

  .fs-hint {
    padding: 8px 0 12px;
    text-align: center;
    font-family: var(--font-kai);
    font-size: 12.5px;
    letter-spacing: 1px;
    color: rgba(232, 237, 243, 0.6);
  }

  .map-note {
    margin-top: 16px;
    font-size: 12px;
    color: var(--text-faint);
    text-align: center;
  }

  @media (max-width: 768px) {
    .radio-tabs-row {
      margin-bottom: 20px;
    }

    .map-stage {
      padding: 8px 8px 4px;
    }

    .map-stage-head {
      padding: 8px 10px 0;
    }

    .region-bar {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 12px 12px 14px;
    }

    .rb-picker {
      justify-content: space-between;
      gap: 4px;
    }

    .rb-pick {
      width: 28px;
      height: 28px;
      font-size: 12px;
    }

    .rb-info {
      gap: 10px;
    }

    .rb-no {
      width: 34px;
      height: 34px;
      font-size: 18px;
    }

    .rb-chip {
      font-size: 12px;
      padding: 2px 8px;
    }
  }
</style>

<script>
  interface RegionInfo {
    prefix: string;
    color: string;
    provinces: string[];
  }

  const REGIONS: Record<string, RegionInfo> = {
    '1': { prefix: 'B1', color: '#e74c3c', provinces: ['北京'] },
    '2': { prefix: 'B2', color: '#5499c7', provinces: ['黑龙江', '吉林', '辽宁'] },
    '3': { prefix: 'B3', color: '#f0cf4a', provinces: ['天津', '内蒙古', '河北', '山西'] },
    '4': { prefix: 'B4', color: '#58d68d', provinces: ['上海', '山东', '江苏'] },
    '5': { prefix: 'B5', color: '#af7ac5', provinces: ['浙江', '江西', '福建'] },
    '6': { prefix: 'B6', color: '#f5b041', provinces: ['安徽', '河南', '湖北'] },
    '7': { prefix: 'B7', color: '#a2d9ce', provinces: ['湖南', '广东', '广西', '海南'] },
    '8': { prefix: 'B8', color: '#ec7063', provinces: ['四川', '重庆', '贵州', '云南'] },
    '9': { prefix: 'B9', color: '#7fb3d5', provinces: ['陕西', '甘肃', '宁夏', '青海'] },
    '0': { prefix: 'B0', color: '#e6b17e', provinces: ['新疆', '西藏'] },
  };

  const svg = document.querySelector<SVGSVGElement>('.map-svg');
  const info = document.querySelector<HTMLElement>('.rb-info');
  const picks = Array.from(document.querySelectorAll<HTMLButtonElement>('.rb-pick'));

  const fullscreen = document.querySelector<HTMLElement>('.map-fullscreen');
  const fsStage = fullscreen?.querySelector<HTMLElement>('.fs-stage');
  const fsClose = fullscreen?.querySelector<HTMLButtonElement>('.fs-close');
  const openBtn = document.querySelector<HTMLButtonElement>('.fullscreen-btn');

  if (svg && info) {
    const targets = Array.from(svg.querySelectorAll<SVGElement>('[data-rg]'));
    let current: string | null = null;

    const renderInfo = (rg: string | null) => {
      if (rg === null) {
        info.classList.add('is-empty');
        info.innerHTML =
          '<p class="rb-hint">把鼠标移到地图上的省份或右侧图例，也可以点下方区号</p>';
        return;
      }
      const data = REGIONS[rg];
      if (!data) return;
      info.classList.remove('is-empty');
      info.style.setProperty('--rgc', data.color);
      info.innerHTML = `
        <span class="rb-no">${rg}</span>
        <span class="rb-meta">
          <b>第 ${rg} 区</b>
          <i>呼号前缀 ${data.prefix}</i>
        </span>
        <span class="rb-prov">${data.provinces
          .map((p) => `<span class="rb-chip">${p}</span>`)
          .join('')}</span>
      `;
    };

    const setRegion = (rg: string | null) => {
      if (rg === current) return;
      current = rg;
      for (const el of targets) {
        el.classList.toggle('on', rg !== null && el.dataset.rg === rg);
      }
      svg.classList.toggle('is-focus', rg !== null);
      for (const b of picks) b.classList.toggle('active', b.dataset.rg === rg);
      renderInfo(rg);
    };

    // 鼠标移入某个省份（或图例色块）；触屏不靠 hover，交给 click
    svg.addEventListener('pointerover', (e) => {
      if (e.pointerType && e.pointerType !== 'mouse') return;
      const hit = (e.target as Element).closest<SVGElement>('[data-rg]');
      if (hit?.dataset.rg) setRegion(hit.dataset.rg);
    });

    // 离开整张地图时复位
    svg.addEventListener('pointerleave', () => setRegion(null));

    // 点击：触屏为切换（再点取消），鼠标为固定选中
    svg.addEventListener('click', (e) => {
      const hit = (e.target as Element).closest<SVGElement>('[data-rg]');
      const rg = hit?.dataset.rg ?? null;
      if (!rg) {
        setRegion(null);
        return;
      }
      const type = (e as PointerEvent).pointerType;
      const isTouch = type === 'touch' || type === 'pen';
      setRegion(isTouch && current === rg ? null : rg);
    });

    // 区号按钮
    for (const btn of picks) {
      btn.addEventListener('click', () => {
        const rg = btn.dataset.rg ?? null;
        setRegion(current === rg ? null : rg);
      });
    }

    // Esc 复位
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setRegion(null);
    });
  }

  /* ---------- 横屏全屏查看 ---------- */
  if (fullscreen && fsStage && fsClose && openBtn) {
    // 全屏层内部的地图，复用同样的「选中大区」交互（独立实例，互不干扰）
    const fsSvg = fsStage.querySelector<SVGSVGElement>('.map-svg');
    if (fsSvg) {
      const fsTargets = Array.from(fsSvg.querySelectorAll<SVGElement>('[data-rg]'));
      let fsCurrent: string | null = null;

      const fsSet = (rg: string | null) => {
        if (rg === fsCurrent) return;
        fsCurrent = rg;
        for (const el of fsTargets) {
          el.classList.toggle('on', rg !== null && el.dataset.rg === rg);
        }
        fsSvg.classList.toggle('is-focus', rg !== null);
      };

      fsSvg.addEventListener('pointerover', (e) => {
        if (e.pointerType && e.pointerType !== 'mouse') return;
        const hit = (e.target as Element).closest<SVGElement>('[data-rg]');
        if (hit?.dataset.rg) fsSet(hit.dataset.rg);
      });

      fsSvg.addEventListener('pointerleave', () => fsSet(null));

      fsSvg.addEventListener('click', (e) => {
        const hit = (e.target as Element).closest<SVGElement>('[data-rg]');
        const rg = hit?.dataset.rg ?? null;
        if (!rg) {
          fsSet(null);
          return;
        }
        const type = (e as PointerEvent).pointerType;
        const isTouch = type === 'touch' || type === 'pen';
        fsSet(isTouch && fsCurrent === rg ? null : rg);
      });
    }

    let lastFocus: Element | null = null;

    const open = () => {
      lastFocus = document.activeElement;
      fullscreen.hidden = false;
      document.body.classList.add('fs-open');
    };

    const close = () => {
      fullscreen.hidden = true;
      document.body.classList.remove('fs-open');
      (lastFocus as HTMLElement | null)?.focus?.();
    };

    openBtn.addEventListener('click', open);
    fsClose.addEventListener('click', close);

    // 点背景空白处或按 Esc 也可退出
    fsStage.addEventListener('click', (e) => {
      if (e.target === fsStage) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !fullscreen.hidden) close();
    });
  }
</script>
